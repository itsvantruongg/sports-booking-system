PORT=5000
MONGODB_URI=your_mongodb_uri
NODE_ENV=development

# JWT — Access token ngắn hạn
JWT_SECRET=your_jwt_secret
JWT_EXPIRE=24h

# Refresh Token dài hạn — phải khác JWT_SECRET
JWT_REFRESH_SECRET=your_refresh_token_secret

# Client URL (Frontend)
CLIENT_URL=http://localhost:3000

# Cron Job Secret — Header: X-Cron-Secret
CRON_SECRET=your_cron_secret

# Email Config (Nodemailer)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password

# VNPay Sandbox Config
VNP_TMN_CODE=your_vnp_tmn_code
VNP_HASH_SECRET=your_vnp_hash_secret
VNP_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNP_API_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction
VNP_RETURN_URL=http://localhost:3000/user/history

# Test Info (Dùng để chạy các script trong thư mục src/)
TEST_PHONE=your_test_phone_number
TEST_EMAIL=your_test_email_address

# Seed Data Credentials (Dùng cho seeder.js)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=your_secure_password
SEED_OWNER_EMAIL=owner@example.com
SEED_OWNER_PASSWORD=your_secure_password
SEED_USER_EMAIL=user@example.com
SEED_USER_PASSWORD=your_secure_password
